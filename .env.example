# Telegram Bot Token obtained from @BotFather.
TG_RELAY_BOT_TOKEN=<bot-token>

# Numeric private-chat ID of the administrator who receives forwarded messages.
TG_RELAY_ADMIN_CHAT_ID=<admin-chat-id>

# Persistent private SQLite state. Do not place this file inside the repository.
TG_RELAY_DB=/var/lib/tg-relay-bot/relay.db